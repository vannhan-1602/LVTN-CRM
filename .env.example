# Copy file này thành ".env" (cùng thư mục với docker-compose.yml) rồi điền giá trị thật.
# docker-compose tự đọc file .env — KHÔNG commit file .env thật lên Git (đã có trong .gitignore).

# ---- Bắt buộc ----
# Chuỗi ngẫu nhiên bảo mật dùng ký JWT — tối thiểu 32 ký tự. Tạo nhanh bằng:
#   openssl rand -base64 48
JWT_SECRET=

# Mật khẩu root MySQL — tự đặt 1 mật khẩu mạnh, không dùng giá trị mặc định khi deploy thật.
DB_ROOT_PASSWORD=changeme_root

# ---- RabbitMQ ----
RABBITMQ_USER=crm
RABBITMQ_PASSWORD=changeme_rabbit

# ---- Email (Gmail App Password — KHÔNG dùng mật khẩu Gmail thật) ----
# Tạo tại: https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASSWORD=

# ---- AI phân tích bán hàng (tùy chọn — để trống thì tính năng AI Dashboard báo lỗi nhưng
# phần còn lại của hệ thống vẫn chạy bình thường) ----
# Miễn phí: lấy API Key tại https://console.groq.com rồi set OPENAI_BASE_URL để dùng model
# tương thích OpenAI của Groq thay vì trả phí OpenAI thật.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ---- Frontend ----
# URL công khai mà TRÌNH DUYỆT của người dùng sẽ gọi tới — nếu deploy lên domain thật, đổi
# thành https://api.your-domain.com/api. Biến này được NHÚNG THẲNG vào bundle lúc build, đổi
# xong phải build lại frontend (docker compose build frontend), không phải chỉ restart.
VITE_API_BASE_URL=http://localhost:8080/api
FRONTEND_URL=http://localhost:5173

ASPNETCORE_ENVIRONMENT=Production
